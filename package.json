{
  "name": "staffsync-capstone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/server.js",
    "dev": "node --watch --env-file-if-exists=.env server/server.js",
    "bootstrap": "node --env-file=.env server/bootstrap.js",
    "test": "node --test --test-concurrency=1 server/tests/*.test.js",
    "client": "vite --host localhost --port 5173",
    "build": "vite build",
    "demo": "npm run build && node scripts/demo.js",
    "format": "prettier --write client server scripts/*.js vite.config.js package.json .github/workflows/*.yml"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "mongodb-memory-server": "^10.2.1",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "vite": "^7.1.0"
  }
}
